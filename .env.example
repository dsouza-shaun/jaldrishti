# Local project database (required)
DATABASE_URL=file:../db/custom.db

# --- Desktop build secrets ----------------------------------------------------
# scripts/build-windows-installer.ps1 bakes these into the installer's
# runtime-config.json, because the Next.js postbuild step strips every .env
# file from the standalone output and the installed launcher runs on a machine
# with no environment variables. Required keys abort the build when missing, so
# an installer cannot ship in a quietly broken state.
#
# These values are recoverable from the shipped installer by anyone who unpacks
# it. Use low-privilege, read-only, quota-capped keys; never a key that carries
# billing or write access. Environment variables still win at launch, so an
# administrator can override a baked value without rebuilding.
#
# GROQ_API_KEY=

# --- Nominatim User-Agent -----------------------------------------------------
# The Nominatim usage policy requires an identifying User-Agent. This one is
# NOT optional in practice, and Nominatim enforces it with HTTP 403.
#
# Verified by direct request against the live service:
#
#   no User-Agent                              -> 403 Access denied
#   Mozilla/5.0                                -> 403 Access denied
#   JalDrishti/0.3.1                           -> 200 OK  (the app's fallback)
#   JalDrishti/0.3.1 (maintainer: you@x.com)   -> 200 OK
#   JalDrishti/0.3.1 (maintainer: x@example.org)-> 403 Access denied
#
# Note the last line: example.org, example.com and example.net are RESERVED
# DOCUMENTATION DOMAINS and Nominatim blocks any User-Agent containing them.
# Do not use one as a placeholder here, or geocoding will fail with a 403 at
# runtime and the cause will not be obvious.
#
# The app falls back to the bare "JalDrishti/0.3.1" when this is unset, which
# works today but carries no contact address. Supply a real one so the operator
# can be contacted if the service needs to throttle or block a client.
#
# NOMINATIM_USER_AGENT=JalDrishti/0.3.1 (maintainer: your-real-address@your-domain)
# If you prefer not to publish an address, a URL works and is equally accepted:
# NOMINATIM_USER_AGENT=JalDrishti/0.3.1 (+https://github.com/your-org/jaldrishti)
#
# Appended automatically as a trailing "(address)" if set, so setting both is
# harmless but redundant.
# NOMINATIM_EMAIL=

# Optional Groq API key for on-demand plain-language explanations.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional absolute path for a mounted/external datasets directory.
# Local development defaults to <repository>/datasets.
# JALDRISHTI_DATASETS_DIR=C:/data/jaldrishti/datasets

# Nominatim public-service policy requires an identifying User-Agent; see the
# desktop-build section above for the verified 403 behaviour and a safe format.
# Keep requests user-triggered: the client already serialises them to ~1/sec.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_ZOOM=14
NOMINATIM_USER_AGENT=JalDrishti/0.3.1 (maintainer: replace-with-a-real-address@invalid.test)
# NOMINATIM_EMAIL=your-real-address@your-domain

# Open-Meteo is free for eligible non-commercial use. Commercial deployments
# should obtain and configure the appropriate Open-Meteo customer API key.
# OPEN_METEO_API_KEY=
# With a key, use customer hosts (the app rejects a free host + key):
# OPEN_METEO_FORECAST_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
# OPEN_METEO_AIR_QUALITY_BASE_URL=https://customer-air-quality-api.open-meteo.com/v1/air-quality
# OPEN_METEO_FLOOD_BASE_URL=https://customer-flood-api.open-meteo.com/v1/flood

# --- National Water Mission ground water map (optional) ---------------------
# https://jalshakti-data.gov.in is not an open WMS. Every /wmsurl/ and
# /wmsurl190/ request answers 302 -> /login without a valid session, and its
# Access-Control-Allow-Origin is its own host only, so these tiles can only be
# loaded through the server-side relay at /api/map-tiles/nwic.
#
# Paste the Cookie header your browser sent for jalshakti-data.gov.in. A bare
# JSESSIONID=... is the usual case:
#   JALDRISHTI_NWIC_COOKIE=JSESSIONID=9B8AE16FEE547C7BF532287CB71AEB05
# Leave it unset and the ground water toggle stays dormant, reporting itself as
# such; the map falls back to public OpenStreetMap water data.
JALDRISHTI_NWIC_COOKIE=
# Override only for a mirror or a different National Water Mission deployment.
# JALDRISHTI_NWIC_BASE_URL=https://jalshakti-data.gov.in
# JALDRISHTI_NWIC_TIMEOUT_MS=12000
